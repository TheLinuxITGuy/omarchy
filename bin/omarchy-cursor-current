#!/bin/bash

# omarchy:summary=Show the current cursor theme
# omarchy:examples=omarchy cursor current

# shellcheck source=omarchy-cursor-config
source "$OMARCHY_PATH/bin/omarchy-cursor-config"

theme=$(cursor_config_read_env HYPRCURSOR_THEME 2>/dev/null || cursor_config_read_env XCURSOR_THEME 2>/dev/null || true)
[[ -n $theme ]] && echo "$theme"
