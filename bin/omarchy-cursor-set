#!/bin/bash

# omarchy:summary=Set the cursor theme
# omarchy:args=<theme-name>
# omarchy:examples=omarchy cursor list | omarchy cursor set Bibata-Modern-Classic

usage() {
  echo "Usage: omarchy-cursor-set <theme-name>"
}

theme="${1:-}"

case "$theme" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

if [[ ! $theme =~ ^[A-Za-z0-9._+-]+$ ]]; then
  echo "Invalid cursor theme name '$theme'." >&2
  exit 1
fi

if ! omarchy-cursor-list | grep -qx -- "$theme"; then
  echo "Cursor theme '$theme' not found."
  exit 1
fi

hypr_config="$HOME/.config/hypr/hyprland.lua"
mkdir -p "$(dirname "$hypr_config")"

cursor_size=$(omarchy-cursor-size-current 2>/dev/null)
[[ $cursor_size =~ ^[0-9]+$ ]] || cursor_size=24

hyprctl setcursor "$theme" "$cursor_size"

update_env() {
  local var="$1"
  local value="$2"
  if grep -q "hl.env(\"$var\"" "$hypr_config"; then
    sed -i "s/hl.env(\"$var\", \"[^\"]*\")/hl.env(\"$var\", \"$value\")/" "$hypr_config"
  else
    echo "hl.env(\"$var\", \"$value\")" >>"$hypr_config"
  fi
}

update_env XCURSOR_THEME "$theme"
update_env HYPRCURSOR_THEME "$theme"

if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
  gsettings set org.gnome.desktop.interface cursor-theme "$theme" || true
  gsettings set org.gnome.desktop.interface cursor-size "$cursor_size" || true
fi

update_gtk_settings() {
  local ini="$1"
  mkdir -p "$(dirname "$ini")"

  if [[ ! -f $ini ]]; then
    printf '[Settings]\ngtk-cursor-theme-name=%s\ngtk-cursor-theme-size=%s\n' "$theme" "$cursor_size" >"$ini"
    return
  fi

  sed -i '/^gtk-cursor-theme-name=/d; /^gtk-cursor-theme-size=/d' "$ini"
  if ! grep -q '^\[Settings\]' "$ini"; then
    printf '\n[Settings]\n' >>"$ini"
  fi
  sed -i "/^\[Settings\]/a\\
gtk-cursor-theme-name=$theme\\
gtk-cursor-theme-size=$cursor_size" "$ini"
}

update_gtk_settings "$HOME/.config/gtk-3.0/settings.ini"
update_gtk_settings "$HOME/.config/gtk-4.0/settings.ini"

omarchy-notification-send -g 󰧨 "Cursor theme set" "$theme" -t 5000
omarchy-hook cursor-set "$theme"
