#!/bin/bash

# omarchy:summary=Set the cursor theme
# omarchy:args=<theme-name>
# omarchy:examples=omarchy cursor list | omarchy cursor set Bibata-Modern-Classic

usage() {
  echo "Usage: omarchy-cursor-set <theme-name>"
}

theme="${1:-}"

case "$theme" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

if [[ ! $theme =~ ^[A-Za-z0-9._+-]+$ ]]; then
  echo "Invalid cursor theme name '$theme'." >&2
  exit 1
fi

if ! omarchy-cursor-list | grep -qx -- "$theme"; then
  echo "Cursor theme '$theme' not found."
  exit 1
fi

# shellcheck source=omarchy-cursor-config
source "$OMARCHY_PATH/bin/omarchy-cursor-config"

cursor_size=$(cursor_config_read_env HYPRCURSOR_SIZE 2>/dev/null || cursor_config_read_env XCURSOR_SIZE 2>/dev/null || true)
[[ $cursor_size =~ ^[0-9]+$ ]] || cursor_size=24

cursor_config_apply_live "$theme" "$cursor_size"
cursor_config_update_env XCURSOR_THEME "$theme"
cursor_config_update_env HYPRCURSOR_THEME "$theme"
cursor_config_sync_gsettings "$theme" "$cursor_size"
cursor_config_update_gtk "$theme" "$cursor_size"
cursor_config_update_icons "$theme"

omarchy-notification-send -g 󰧨 "Cursor theme set" "$theme" -t 5000
omarchy-hook cursor-set "$theme"
