#!/bin/bash

# omarchy:summary=Show the current cursor size
# omarchy:examples=omarchy cursor size current

# shellcheck source=omarchy-cursor-config
source "$OMARCHY_PATH/bin/omarchy-cursor-config"

size=$(cursor_config_read_env HYPRCURSOR_SIZE 2>/dev/null || cursor_config_read_env XCURSOR_SIZE 2>/dev/null || true)
if [[ $size =~ ^[0-9]+$ ]]; then
  echo "$size"
  exit 0
fi

gsize=$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null | tr -d "'")
if [[ $gsize =~ ^[0-9]+$ ]]; then
  echo "$gsize"
  exit 0
fi

echo 24
