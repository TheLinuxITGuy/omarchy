#!/bin/bash

# omarchy:summary=Set the cursor size
# omarchy:args=<size-in-px>
# omarchy:examples=omarchy cursor size list | omarchy cursor size set 32

usage() {
  echo "Usage: omarchy-cursor-size-set <size-in-px>"
}

size="${1:-}"

case "$size" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

if [[ ! $size =~ ^[0-9]+$ ]] || (( size < 1 || size > 512 )); then
  echo "Invalid cursor size '$size'." >&2
  exit 1
fi

# shellcheck source=omarchy-cursor-config
source "$OMARCHY_PATH/install/omarchy-cursor-config"

theme=$(cursor_config_read_env HYPRCURSOR_THEME 2>/dev/null || cursor_config_read_env XCURSOR_THEME 2>/dev/null || true)

cursor_config_apply_live "$theme" "$size"
cursor_config_update_env XCURSOR_SIZE "$size"
cursor_config_update_env HYPRCURSOR_SIZE "$size"
cursor_config_sync_gsettings "$theme" "$size"
cursor_config_update_gtk "$theme" "$size"

omarchy-notification-send -g 󰧨 "Cursor size set" "$size" -t 5000
omarchy-hook cursor-size-set "$size"
